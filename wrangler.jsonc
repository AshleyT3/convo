// Cloudflare Worker that serves the built app as static files at <your-domain>/convo
// Build first with `npm run build:cf` (outputs to cf-site/convo/), then `npx wrangler deploy`.
// Change the route below to your own domain (it must be a zone in your Cloudflare account).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "convo",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./cf-site",
    // /convo -> /convo/ and serves convo/index.html
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "workers_dev": false,
  "routes": [
    { "pattern": "ashleypurringtech.com/convo*", "zone_name": "ashleypurringtech.com" },
    { "pattern": "www.ashleypurringtech.com/convo*", "zone_name": "ashleypurringtech.com" }
  ]
}
